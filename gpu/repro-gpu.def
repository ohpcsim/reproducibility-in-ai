# 1c's container: your conda lock and the GPU check, built with Apptainer.
Bootstrap: docker
From: ubuntu@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

%files
    lock.txt /opt/lock.txt
    verify_gpu.py /opt/verify_gpu.py

%post
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
    rm -rf /var/lib/apt/lists/*
    MINIFORGE_VERSION=26.9.4-2
    curl -fsSL -o /tmp/miniforge.sh \
      "https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-${MINIFORGE_VERSION}-Linux-$(uname -m).sh"
    bash /tmp/miniforge.sh -b -p /opt/conda && rm /tmp/miniforge.sh
    /opt/conda/bin/conda create -y -n repro-gpu --file /opt/lock.txt
    /opt/conda/bin/conda clean -afy
    rm /opt/lock.txt

%environment
    export PATH=/opt/conda/envs/repro-gpu/bin:$PATH

%runscript
    exec python /opt/verify_gpu.py
