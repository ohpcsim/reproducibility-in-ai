#!/bin/bash
# Set up the Binder session at build time, so the learner starts ready to work.
set -euo pipefail
python scripts/setup_project.py
jupyter lab workspaces import .binder/workspace.json
settings=~/.jupyter/lab/user-settings/@jupyterlab/apputils-extension
mkdir -p "$settings"
echo '{"fetchNews": "false"}' > "$settings/notification.jupyterlab-settings"
# New terminals start in the project folder, with a short prompt. Only interactive shells, because the server itself starts through a login shell.
for startup in ~/.bashrc ~/.profile; do
    echo 'case $- in *i*) if [ "$PWD" = "$HOME" ] && [ -d "$HOME/project" ]; then cd "$HOME/project"; fi; PS1="\\w\\$ " ;; esac' >> "$startup"
done
